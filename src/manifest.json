{
  "manifest_version": 3,
  "name": "网页视频下载器",
  "description": "识别当前标签页的完整视频、HLS 和 DASH，并在浏览器内保存。",
  "version": "0.2.18",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "webNavigation", "offscreen", "downloads", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["player-events.js"], "all_frames": true, "run_at": "document_start"}],
  "options_page": "options.html",
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "网页视频下载器",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  }
}
